{
  "name": "spatial-kanban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A WebXR kanban board you pin to your wall in mixed reality.",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "dev:sync": "vite --mode sync",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "worker:dev": "vite build && wrangler d1 migrations apply spatial-kanban --local && wrangler dev --port 8787",
    "deploy": "vite build && wrangler deploy && wrangler d1 migrations apply spatial-kanban --remote",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/xr": "^6.6.30",
    "dexie": "^4.4.6",
    "fractional-indexing": "^4.0.0",
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "troika-three-text": "^0.52.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@iwer/devui": "^2.5.0",
    "@iwer/sem": "^2.5.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "iwer": "^2.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mneuffer-protogen/spatial-kanban.git"
  },
  "homepage": "https://mneuffer-protogen.github.io/spatial-kanban/"
}
